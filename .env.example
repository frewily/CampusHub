# This file documents local environment variables. Spring Boot does not load it automatically.
DB_URL='jdbc:mysql://127.0.0.1:3307/campushub?useSSL=false&serverTimezone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true'
DB_USERNAME=campushub
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PUBLISHED_PORT=3307
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
# Local Compose script accepts only [A-Za-z0-9._-]; replace this demo value.
REDIS_PASSWORD=change-me-redis
REDIS_PUBLISHED_PORT=6380
APP_PUBLISHED_PORT=8081
# Host-only management listener; do not reuse the business port.
MANAGEMENT_PORT=8082
# Used only when compose.monitoring.yaml is explicitly included.
PROMETHEUS_PUBLISHED_PORT=9090
IMAGE_STORAGE_DIR=./data/uploads
SPRING_PROFILES_ACTIVE=dev
ORDER_STREAM_CONSUMER_ENABLED=true
# Must exceed normal transaction latency; claims are at-least-once, not exclusive execution leases.
ORDER_CLAIM_IDLE_MS=60000
ORDER_MAX_ATTEMPTS=5
ORDER_CANCELLATION_RECONCILER_ENABLED=true
SHOP_CACHE_INVALIDATION_WORKER_ENABLED=true
