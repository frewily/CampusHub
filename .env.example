# This file documents local environment variables. Spring Boot does not load it automatically.
DB_URL='jdbc:mysql://127.0.0.1:3306/hmdp?useSSL=false&serverTimezone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true'
DB_USERNAME=root
DB_PASSWORD=change-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
ORDER_STREAM_CONSUMER_ENABLED=true
# Must exceed normal transaction latency; claims are at-least-once, not exclusive execution leases.
ORDER_CLAIM_IDLE_MS=60000
ORDER_MAX_ATTEMPTS=5
ORDER_CANCELLATION_RECONCILER_ENABLED=true
SHOP_CACHE_INVALIDATION_WORKER_ENABLED=true
